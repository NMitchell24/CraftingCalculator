<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+ (android:dataExtractionRules), mirroring auto_backup_rules.xml: diagnostic
     logs stay on the device that produced them, while the database and exports transfer with the user. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="Logs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="Logs" />
    </device-transfer>
</data-extraction-rules>
