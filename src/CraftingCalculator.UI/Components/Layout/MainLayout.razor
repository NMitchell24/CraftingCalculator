@inherits LayoutComponentBase

@* ObserveSystemDarkModeChange is what installs MudBlazor's own media-query watch, so binding it to the
   System mode is all that is needed: in System mode the provider writes the OS value into _isDarkMode
   itself, and in Light/Dark it stops watching and OnThemeChanged sets the value outright. *@
<MudThemeProvider Theme="AppTheme.Theme" @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode"
                  ObserveSystemDarkModeChange="@(ThemeState.Mode == ThemeMode.System)" />
<MudPopoverProvider />
@* Dialogs render here rather than under @Body, so the page boundary below is no use to them: a throw from
   inside a dialog needs a boundary of its own, or it reaches the renderer and freezes the app. OnFaulted is
   what puts the provider back - see MainLayout.OnDialogFaulted. *@
<LoggingErrorBoundary @ref="_dialogBoundary" Scope="dialog" OnFaulted="OnDialogFaulted">
    <ChildContent>
        @* The app's dialog house style, set once here rather than in every ShowAsync/ShowMessageBoxAsync call.
           RecordPickerDialog and LogViewerDialog override it (FullScreen on xs). *@
        <MudDialogProvider MaxWidth="MaxWidth.Small" FullWidth="true" CloseOnEscapeKey="true" BackdropClick="true" />
    </ChildContent>
    <ErrorContent>
        @* Nothing: the failure is reported by the dialog OnDialogFaulted opens once the provider is back, and
           an error card here would be a dialog-shaped hole left on top of a page that is still perfectly usable.
           This fragment exists so the boundary renders it instead of Blazor's own default error markup. *@
    </ErrorContent>
</LoggingErrorBoundary>
<MudSnackbarProvider />

@* The Breakpoint is cascaded from here rather than by a MudBreakpointProvider: this layout needs the
   viewport's height as well as its width (see ShowFullDrawer), and IBrowserViewportService delivers
   both in one notification. A provider on top of that subscription would be a second listener for a
   value this component already has. *@
<CascadingValue Value="_breakpoint ?? Breakpoint.Xs" IsFixed="false">
    <MudLayout>
        @* Three tracks with equal-width sides while the title fits (app.css) so it is centered on the
           viewport rather than on the space the icons leave - a MudSpacer would push it off-center on
           every page without a back arrow. The page's own actions live on the ActionsBar below, not up here.
           data-height-var is read by the height-measuring script in js/layout.js: the bar grows when its
           title wraps, and everything that parks under it offsets by --app-bar-height (app.css). *@
        <MudAppBar Dense="true" Elevation="1" Style="padding-top: max(env(safe-area-inset-top), var(--safe-area-inset-top));"
                   data-height-var="--app-bar-height">
            <div class="app-bar-start">
                @* Only where the labelled drawer could show: the Mini rail is the only face a smaller
                   viewport has, so there is nothing for the toggle to switch between. Edge.Start takes
                   back the button's 12px inner padding, which is what lines its icon up with the drawer's
                   icons directly below it. *@
                @if (ShowFullDrawer)
                {
                    <MudIconButton Icon="@DrawerToggleIcon" Color="Color.Inherit" OnClick="ToggleDrawer" Edge="Edge.Start"
                                   title="@DrawerToggleLabel" aria-label="@DrawerToggleLabel" />
                }
                @if (PageShellState.Config.ShowBack)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="GoBackAsync"
                                   aria-label="Back" />
                }
            </div>

            <MudText Typo="Typo.h6" Class="app-bar-title display-title">@PageShellState.Config.Title</MudText>

            <div class="app-bar-end">
                @* Context sensitive: on any page but Help this opens the help page for the route the
                   user is on (HelpProcessor.ResolveTopic), so the button answers "what is this screen"
                   rather than dropping everyone on the contents list. *@
                <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Inherit" OnClick="ToggleHelpAsync"
                               title="@HelpActionLabel" aria-label="@HelpActionLabel" />
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" OnClick="ToggleSettingsAsync"
                               title="@SettingsActionLabel" aria-label="@SettingsActionLabel" />
            </div>
        </MudAppBar>

        @if (ShowSideRail)
        {
            @* Open is what picks a Mini drawer's face, not just whether it is on screen: MudBlazor
               renders the icon-only rail from the *closed* mini state and expands it to full width when
               open. Open="true" on a Mini drawer therefore showed a labelled drawer that snapped to
               icons the moment MudBlazor's own responsive logic closed it - the collapse-on-first-tap
               bug. Persistent is the opposite and has to stay open to show at all. Both are driven by
               DrawerExpanded, so a collapsed drawer is a closed Mini rail and never an open one. *@
            <MudDrawer Open="@DrawerExpanded" Fixed="true" Variant="@(DrawerExpanded ? DrawerVariant.Persistent : DrawerVariant.Mini)" ClipMode="DrawerClipMode.Always" Elevation="1">
                <MudNavMenu Color="Color.Primary" Rounded="true">
                    @* Still links, so NavLink keeps highlighting the current destination, but the click is taken
                       over: preventDefault stops Blazor's own link navigation and OpenDestinationAsync navigates
                       instead. *@
                    @foreach (Destination destination in Destinations)
                    {
                        <div class="nav-destination" @onclick="() => OpenDestinationAsync(destination)" @onclick:preventDefault>
                            <MudNavLink Href="@destination.Route" Match="@destination.Match" Icon="@destination.Icon">@destination.Label</MudNavLink>
                        </div>
                    }
                    <ActionsBar Actions="@PageShellState.Config.Actions" Mode="ActionsBarMode.Drawer"
                                MaxVisible="@ActionsMaxVisible" />
                </MudNavMenu>
            </MudDrawer>
        }

        <MudMainContent Class="@MainContentClass">
            @if (_dialogFailed)
            {
                @* Reported on the screen rather than in a dialog of its own. The dialog system is what just
                   failed, so asking the provider that failed to render the report can fail in turn - and that
                   loops, because Recover resets the error count ErrorBoundaryBase would otherwise stop it with
                   (measured: ~90% CPU and the whole three-file log ring rewritten inside a minute). This is
                   MainLayout's own markup, outside both boundaries, and it needs no provider at all. A failure that
                   belongs to the screen it happened on is an inline alert, not a dialog. *@
                <MudAlert Severity="Severity.Error" Class="dialog-error-alert" ShowCloseIcon="true"
                          CloseIconClicked="DismissDialogFailure" role="alert">
                    The dialog I was supposed to show ran into a problem so I closed it. The problem has been written to the log.
                </MudAlert>
            }

            @* Left out while OpenDestinationAsync steps back through history, so the pages it passes are never
               created and the page being left is disposed before the first step. *@
            @if (!_unwinding)
            {
                @* Around the page only: the app bar, the nav and the actions bar are outside it, so a page that
                   fails leaves the user somewhere to go. Page loads are deliberately left unguarded - a throw on
                   the way in belongs here rather than in a catch that renders half a screen. *@
                <LoggingErrorBoundary @ref="_pageBoundary" Scope="page">
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent>
                        <MudPaper Class="app-card page-error-card" Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                            <MudText Typo="Typo.subtitle1" Class="app-card-title display-title">Something went wrong</MudText>
                            <MudText>This screen ran into a problem. It's not you. It's me. The problem has been written to the log.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClearPageErrorAsync">
                                @PageErrorActionLabel
                            </MudButton>
                        </MudPaper>
                    </ErrorContent>
                </LoggingErrorBoundary>
            }
        </MudMainContent>

        @if (ShowActionsBar)
        {
            <ActionsBar Actions="@PageShellState.Config.Actions" Mode="ActionsBarMode.BottomBar"
                        MaxVisible="@ActionsMaxVisible" />
        }

        @if (ShowBottomNav)
        {
            <MudPaper Class="bottom-nav" Elevation="3" Square="true">
                <MudNavMenu Class="bottom-nav-menu" Color="Color.Primary">
                    @* Taken over the same way as the side rail's. *@
                    @foreach (Destination destination in Destinations)
                    {
                        <div class="nav-destination" @onclick="() => OpenDestinationAsync(destination)" @onclick:preventDefault>
                            <MudNavLink Href="@destination.Route" Match="@destination.Match" Icon="@destination.Icon">@destination.Label</MudNavLink>
                        </div>
                    }
                </MudNavMenu>
            </MudPaper>
        }
    </MudLayout>
</CascadingValue>
