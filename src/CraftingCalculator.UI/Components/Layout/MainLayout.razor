@inherits LayoutComponentBase

@* ObserveSystemDarkModeChange is what installs MudBlazor's own media-query watch, so binding it to the
   System mode is all that is needed: in System mode the provider writes the OS value into _isDarkMode
   itself, and in Light/Dark it stops watching and OnThemeChanged sets the value outright. *@
<MudThemeProvider Theme="AppTheme.Theme" @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode"
                  ObserveSystemDarkModeChange="@(ThemeState.Mode == ThemeMode.System)" />
<MudPopoverProvider />
@* The app's dialog house style, set once here rather than in every ShowAsync/ShowMessageBoxAsync call.
   BlueprintPickerDialog is the only dialog that overrides it (FullScreen on xs). *@
<MudDialogProvider MaxWidth="MaxWidth.Small" FullWidth="true" CloseOnEscapeKey="true" BackdropClick="true" />
<MudSnackbarProvider />

@* The Breakpoint is cascaded from here rather than by a MudBreakpointProvider: this layout needs the
   viewport's height as well as its width (see ShowFullDrawer), and IBrowserViewportService delivers
   both in one notification. A provider on top of that subscription would be a second listener for a
   value this component already has. *@
<CascadingValue Value="_breakpoint ?? Breakpoint.Xs" IsFixed="false">
    <MudLayout>
        @* Three tracks with equal-width sides (app.css) so the title is centred on the viewport no
           matter how many icons each side holds - a MudSpacer would push it off-centre, since the
           action side is always heavier than the back-arrow side. *@
        <MudAppBar Dense="true" Elevation="1" Style="padding-top: max(env(safe-area-inset-top), var(--safe-area-inset-top));">
            <div class="app-bar-start">
                @if (AppBarState.Config.BackHref is string backHref)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" Href="@backHref"
                                   aria-label="Back" />
                }
            </div>

            <MudText Typo="Typo.h6" Class="@AppBarTitleClass">@AppBarState.Config.Title</MudText>

            <div class="app-bar-end">
                @if (AppBarState.Config.PrimaryAction is AppBarAction action)
                {
                    <MudIconButton Icon="@action.Icon" Color="Color.Inherit" Disabled="@action.Disabled"
                                   OnClick="@(() => action.OnClick())" title="@action.Label" aria-label="@action.Label" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" OnClick="ToggleSettings"
                               title="@SettingsActionLabel" aria-label="@SettingsActionLabel" />
                @if (AppBarState.Config.MenuItems.Count > 0)
                {
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" AriaLabel="More actions"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        @foreach (AppBarMenuItem item in AppBarState.Config.MenuItems)
                        {
                            <MudMenuItem Icon="@item.Icon" OnClick="@(() => item.OnClick())">@item.Text</MudMenuItem>
                        }
                    </MudMenu>
                }
            </div>
        </MudAppBar>

        @if (ShowSideRail)
        {
            @* Open is what picks a Mini drawer's face, not just whether it is on screen: MudBlazor
               renders the icon-only rail from the *closed* mini state and expands it to full width when
               open. Open="true" on a Mini drawer therefore showed a labelled drawer that snapped to
               icons the moment MudBlazor's own responsive logic closed it - the collapse-on-first-tap
               bug. Persistent is the opposite and has to stay open to show at all. *@
            <MudDrawer Open="@ShowFullDrawer" Fixed="true" Variant="@(ShowFullDrawer ? DrawerVariant.Persistent : DrawerVariant.Mini)" ClipMode="DrawerClipMode.Always" Elevation="1">
                <MudNavMenu Color="Color.Primary" Rounded="true">
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Calculate">Craft</MudNavLink>
                    <MudNavLink Href="/favorites" Icon="@Icons.Material.Filled.Star">Favorites</MudNavLink>
                    <MudNavLink Href="/dataset" Icon="@Icons.Material.Filled.MenuBook">Dataset</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        }

        <MudMainContent Class="@(ShowBottomNav ? "page-content page-content-with-bottom-nav" : "page-content")">
            @Body
        </MudMainContent>

        @if (ShowBottomNav)
        {
            <MudPaper Class="bottom-nav" Elevation="3" Square="true">
                <MudNavMenu Class="bottom-nav-menu" Color="Color.Primary">
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Calculate">Craft</MudNavLink>
                    <MudNavLink Href="/favorites" Icon="@Icons.Material.Filled.Star">Favorites</MudNavLink>
                    <MudNavLink Href="/dataset" Icon="@Icons.Material.Filled.MenuBook">Dataset</MudNavLink>
                </MudNavMenu>
            </MudPaper>
        }
    </MudLayout>
</CascadingValue>
