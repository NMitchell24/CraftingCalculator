@inherits LayoutComponentBase

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged">
    <MudLayout>
        <MudAppBar Dense="true" Elevation="1" Style="padding-top: max(env(safe-area-inset-top), var(--safe-area-inset-top));">
            <MudText Typo="Typo.h6">@AppBarState.Title</MudText>
            <MudSpacer />
            @if (AppBarState.MenuItems.Count > 0)
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit">
                    @foreach (AppBarMenuItem item in AppBarState.MenuItems)
                    {
                        <MudMenuItem Icon="@item.Icon" OnClick="@(() => item.OnClick())">@item.Text</MudMenuItem>
                    }
                </MudMenu>
            }
        </MudAppBar>

        @if (ShowSideRail)
        {
            <MudDrawer Open="true" Fixed="true" Variant="@(_breakpoint == Breakpoint.Sm ? DrawerVariant.Mini : DrawerVariant.Persistent)" ClipMode="DrawerClipMode.Always" Elevation="1">
                <MudNavMenu Color="Color.Primary" Rounded="true">
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Calculate">Calculate</MudNavLink>
                    <MudNavLink Href="/favorites" Icon="@Icons.Material.Filled.Star">Favorites</MudNavLink>
                    <MudNavLink Href="/library" Icon="@Icons.Material.Filled.MenuBook">Library</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        }

        <MudMainContent Class="@(ShowBottomNav ? "page-content page-content-with-bottom-nav" : "page-content")">
            @Body
        </MudMainContent>

        @if (ShowBottomNav)
        {
            <MudPaper Class="bottom-nav" Elevation="8" Square="true">
                <MudNavMenu Class="bottom-nav-menu" Color="Color.Primary">
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Calculate">Calculate</MudNavLink>
                    <MudNavLink Href="/favorites" Icon="@Icons.Material.Filled.Star">Favorites</MudNavLink>
                    <MudNavLink Href="/library" Icon="@Icons.Material.Filled.MenuBook">Library</MudNavLink>
                </MudNavMenu>
            </MudPaper>
        }
    </MudLayout>
</MudBreakpointProvider>
