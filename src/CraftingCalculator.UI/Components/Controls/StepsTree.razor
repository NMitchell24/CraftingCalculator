@implements IDisposable

<div class="steps-tree">
    <div class="steps-tree-header">
        <MudText Typo="Typo.subtitle1">Steps</MudText>
        <MudButton Size="Size.Small" OnClick="@State.ExpandAll">Expand All</MudButton>
        <MudButton Size="Size.Small" OnClick="@State.CollapseAll">Collapse All</MudButton>
    </div>

    @if (State.TreeRoots.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">Nothing to break down yet</MudText>
        </div>
    }
    else
    {
        <MudTreeView T="RecipeNode" Class="steps-tree-view">
            @foreach (RecipeNode root in State.TreeRoots)
            {
                <RecipeTreeNode Node="root" />
            }
        </MudTreeView>
    }
</div>
