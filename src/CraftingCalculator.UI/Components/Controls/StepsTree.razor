@implements IDisposable

<div class="steps-tree">
    <div class="steps-tree-header">
        <MudText Typo="Typo.subtitle1" Class="pane-title">Steps</MudText>
        <div class="pane-header-actions">
            <MudIconButton Icon="@Icons.Material.Filled.UnfoldMore" OnClick="@State.ExpandAll"
                           title="Expand all" aria-label="Expand all" />
            <MudIconButton Icon="@Icons.Material.Filled.UnfoldLess" OnClick="@State.CollapseAll"
                           title="Collapse all" aria-label="Collapse all" />
        </div>
    </div>

    @if (State.TreeRoots.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">Nothing to break down yet</MudText>
        </div>
    }
    else
    {
        <MudTreeView T="RecipeNode" Class="steps-tree-view">
            @foreach (RecipeNode root in State.TreeRoots)
            {
                <RecipeTreeNode Node="root" />
            }
        </MudTreeView>
    }
</div>
