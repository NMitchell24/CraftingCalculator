@implements IDisposable

<div class="materials-list">
    @if (State.SurplusStock.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No surplus</MudText>
        </div>
    }
    else
    {
        <MudList T="BlueprintQuantity">
            @foreach (BlueprintQuantity blueprintQuantity in State.SurplusStock)
            {
                <MudListItem T="BlueprintQuantity" OnClick="@(() => ShowInfoAsync(blueprintQuantity))">
                    @* Same figures as MaterialsList - a paired label/value grid in the trailing cell - so it
                       reuses those classes rather than cloning them under a surplus- prefix. *@
                    <div class="record-row">
                        <MudText Class="record-row-name">@blueprintQuantity.Name</MudText>
                        <div class="record-row-meta"><CategoryChip Record="@blueprintQuantity.Blueprint" Class="record-row-category" /></div>
                        <div class="record-row-end">
                            <div class="materials-row-stats">
                                <MudText Typo="Typo.caption" Class="materials-row-label">Quantity</MudText>
                                <MudText Typo="Typo.caption" Class="materials-row-label materials-row-end">Value</MudText>
                                <MudText>x@(blueprintQuantity.Quantity)</MudText>
                                <MudText Class="materials-row-end">@string.Format(FormatConstants.CurrencyFormat, blueprintQuantity.TotalValue)</MudText>
                            </div>
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>
