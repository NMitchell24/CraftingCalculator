<div class="materials-list">
    @if (Surplus.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No surplus</MudText>
        </div>
    }
    else
    {
        <MudList T="BlueprintQuantity" ReadOnly="true">
            <Virtualize Items="Surplus" ItemSize="RowHeight" OverscanCount="RecordCard.OverscanCount"
                        Context="blueprintQuantity">
                <MudListItem T="BlueprintQuantity" @key="blueprintQuantity.Blueprint.Id">
                    <RecordCard Name="@blueprintQuantity.Name" Record="@blueprintQuantity.Blueprint"
                                Details="@DetailsFor(blueprintQuantity)" />
                </MudListItem>
            </Virtualize>
        </MudList>
    }
</div>
