@* Resolves the asterisk BlueprintTreeNode puts on those rows. Rendered once for the whole tree, and only
   while a row carrying one is on screen. *@
@if (State.HasVisibleCraftCountedStep)
{
    <MudText Typo="Typo.caption" Class="steps-tree-legend">
        * This crafting step makes items in batches, or uses surplus from a step above it. The number
        shown is how many crafts this step needs.
    </MudText>
}
