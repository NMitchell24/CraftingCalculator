<div class="batch-list">
    @if (State.BlueprintQuantities.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No blueprints selected yet</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OnAddBlueprints" Class="mt-2">Craft blueprint</MudButton>
        </div>
    }
    else
    {
        <MudList T="BlueprintQuantity">
            @foreach (BlueprintQuantity selected in State.BlueprintQuantities)
            {
                <MudListItem T="BlueprintQuantity" Ripple="false">
                    <RecordCard Name="@selected.Name" Record="@selected.Blueprint">
                        <Stepper>
                            <QuantityStepper Quantity="@selected.Quantity" OnStep="@(step => State.Step(selected, step))"
                                             OnQuantityChanged="@(quantity => State.SetQuantity(selected, quantity))" />
                        </Stepper>
                        <Actions>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                           title="@RemoveLabel(selected)" aria-label="@RemoveLabel(selected)"
                                           OnClick="@(() => State.Remove(selected))" />
                        </Actions>
                    </RecordCard>
                </MudListItem>
            }
        </MudList>
    }
</div>
