@implements IDisposable

<div class="batch-list">
    @if (State.BlueprintQuantities.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No blueprints selected yet</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OnAddBlueprints" Class="mt-2">Craft Blueprint</MudButton>
        </div>
    }
    else
    {
        <MudList T="BlueprintQuantity">
            @foreach (BlueprintQuantity selected in State.BlueprintQuantities)
            {
                <MudListItem T="BlueprintQuantity">
                    @* Two lines rather than the one-line .list-row shape: the name gets a line of its
                       own so a long blueprint name has the full card width before it ellipsizes. *@
                    <div class="batch-row">
                        <div class="batch-row-header">
                            <MudText Class="list-row-name batch-row-name">@selected.Name</MudText>
                            @if (!string.IsNullOrWhiteSpace(selected.CategoryName))
                            {
                                @* Outlined primary rather than the default grey, which disappeared against the light card.
                                   Color.Primary is themed for both palettes, so it follows dark mode too. *@
                                <MudChip T="string" Text="@selected.CategoryName" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="Color.Primary" Ripple="false" Class="batch-row-category" />
                            }
                        </div>
                        <div class="batch-row-actions">
                            <div class="list-row-stepper">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Medium" OnClick="@(() => State.SetQuantity(selected, selected.Quantity - 1))" />
                                <MudNumericField T="long" Value="selected.Quantity" ValueChanged="@(v => State.SetQuantity(selected, v))"
                                                 Min="0" DebounceInterval="300" HideSpinButtons="true" Class="list-row-qty-field"
                                                 onfocus="this.select()" />
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Medium" OnClick="@(() => State.SetQuantity(selected, selected.Quantity + 1))" />
                            </div>
                            <div class="batch-row-icons">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" OnClick="@(() => ShowInfoAsync(selected))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => State.Remove(selected))" />
                            </div>
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>
