@if (CategoryName is { Length: > 0 } name)
{
    @* Outlined primary rather than the default grey, which disappeared against the light card.
       Color.Primary is themed for both palettes, so it follows dark mode too. *@
    <MudChip T="string" Text="@name" Size="Size.Small" Variant="Variant.Outlined"
             Color="Color.Primary" Ripple="false" Class="@Class" />
}
