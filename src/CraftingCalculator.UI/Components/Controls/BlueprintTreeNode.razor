@* MudTreeViewItem shows its expand arrow whenever ChildContent is non-null, regardless of whether the
   render fragment produces any elements - a zero-iteration @foreach still counts. Leaf nodes (no
   Children) render a second, ChildContent-free tag so the arrow is correctly hidden for them. *@
@if (Node.Children.Count > 0)
{
    <MudTreeViewItem T="BlueprintNode" Value="Node" Text="@Node.Name"
                     Icon="@(Node.IsComponent ? Icons.Material.Filled.Inventory2 : Icons.Material.Filled.Handyman)"
                     Expanded="@State.IsExpanded(Path)" ExpandedChanged="@(_ => State.ToggleExpanded(Path))">
        @foreach (BlueprintNode child in Node.Children)
        {
            <BlueprintTreeNode Node="child" ParentPath="@Path" />
        }
    </MudTreeViewItem>
}
else
{
    <MudTreeViewItem T="BlueprintNode" Value="Node" Text="@Node.Name"
                     Icon="@(Node.IsComponent ? Icons.Material.Filled.Inventory2 : Icons.Material.Filled.Handyman)" />
}
