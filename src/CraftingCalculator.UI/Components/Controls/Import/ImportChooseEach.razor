@using CraftingCalculator.Domain.Models.Transfer
@inherits BaseImportControl

<ImportStepCard Title="Step 4: Select records to replace">
    <MudText Typo="Typo.body1">Tap the ones you want to replace. Everything you don't pick stays as it is.</MudText>
    @if (CycleMessage is { } cycleMessage)
    {
        <MudAlert Severity="Severity.Warning">@cycleMessage</MudAlert>
    }
</ImportStepCard>

<MudExpansionPanels MultiExpansion="true" Class="transfer-panels">
    @foreach ((TransferRecordKinds.Display panel, List<ImportConflict> rows) in _panels)
    {
        int picked = rows.Count(IsPicked);
        SelectionState state = TransferSelectionProcessor.StateOf(picked, rows.Count);

        @* KeepContentAlive off for the reason TransferSelectionPanels gives: a collapsed panel's rows would stay in the
           DOM at zero height, where Virtualize renders far more than a screenful. *@
        <MudExpansionPanel @key="panel.Kind" KeepContentAlive="false"
                           HeaderClass="@(picked == 0 ? "" : "transfer-panel-selected")">
            <TitleContent>
                <div class="transfer-panel-header">
                    <MudIcon Icon="@panel.Icon" Class="transfer-panel-icon" />
                    <MudText Typo="Typo.subtitle1" Class="transfer-panel-title">@panel.Title</MudText>
                    <MudText Typo="Typo.body2" Class="transfer-panel-count">@picked</MudText>
                    <SelectAllToggle State="state" Title="@panel.Title" OnToggle="@(() => ToggleAll(rows, state))" />
                </div>
            </TitleContent>
            <ChildContent>
                <div class="transfer-rows">
                    <Virtualize Items="rows" ItemSize="RowHeight" Context="conflict">
                        <div @key="KeyOf(conflict)" class="@RowClass(conflict)">
                            <button type="button" class="transfer-row-select"
                                    aria-pressed="@(IsPicked(conflict) ? "true" : "false")"
                                    @onclick="() => ImportState.ToggleReplace(KeyOf(conflict))">
                                <span class="transfer-row-name">@conflict.Name</span>
                            </button>
                        </div>
                    </Virtualize>
                </div>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="transfer-action"
           StartIcon="@Icons.Material.Filled.Input" OnClick="OnImport">
    Import Selected
</MudButton>
<MudButton Variant="Variant.Text" FullWidth="true" Class="transfer-action" OnClick="ImportState.BackToReview">
    Cancel
</MudButton>
