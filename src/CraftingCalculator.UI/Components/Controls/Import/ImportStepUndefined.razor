@inherits BaseImportControl

<ImportStepCard Title="No UI Exists for this Step">
    <MudAlert Severity="Severity.Error">Import Step is Undefined!</MudAlert>
    <MudText Typo="Typo.body1">
        A user should never see this screen. This exists as a switch case default for Import.razor.
        If you see this screen it likely means that a new ImportStep was added into ImportState but no UI
        exists yet for that step. If you downloaded this app from an app store and you see this message,
        report it as a bug and provide detailed steps that let our developers know how you got here.
    </MudText>
    <MudButton Variant="Variant.Text" FullWidth="true" Class="transfer-action" OnClick="@ImportState.Reset">
        Reset Import Wizard
    </MudButton>
</ImportStepCard>
