@implements IDisposable

<MudPaper Class="totals-bar" Elevation="8" Square="true">
    <div class="totals-bar-line totals-bar-line-full">
        <span class="totals-bar-item"><span class="totals-bar-label">Cost</span> @string.Format(FormatConstants.CurrencyFormat, State.TotalCost)</span>
        <span class="totals-bar-item"><span class="totals-bar-label">Value</span> @string.Format(FormatConstants.CurrencyFormat, State.TotalValue)</span>
        <span class="totals-bar-item"><span class="totals-bar-label">Profit</span> @string.Format(FormatConstants.CurrencyFormat, State.Profit)</span>
    </div>
    <div class="totals-bar-line totals-bar-line-compact">
        @string.Format(FormatConstants.CurrencyFormat, State.TotalCost) / @string.Format(FormatConstants.CurrencyFormat, State.TotalValue) / @string.Format(FormatConstants.CurrencyFormat, State.Profit)
    </div>
</MudPaper>
