<MudExpansionPanels MultiExpansion="true" Class="transfer-panels">
    @foreach (TransferRecordKinds.Display panel in TransferRecordKinds.All)
    {
        SelectionState state = TransferSelectionProcessor.StateOf(Graph, Selected, panel.Kind);
        List<Row> rows = _rows[panel.Kind];

        @* KeepContentAlive off: a collapsed panel's rows would otherwise stay in the DOM at zero height, where
           Virtualize cannot tell how many fit and renders far more than a screenful. HideIcon because
           TransferPanelHeader draws the caret itself; the header tap still toggles the panel, and Expanded is
           bound so the caret follows it. *@
        <MudExpansionPanel @key="panel.Kind" KeepContentAlive="false" HideIcon="true" Disabled="@(rows.Count == 0)"
                           @bind-Expanded="_expanded[panel.Kind]"
                           HeaderClass="@(state == SelectionState.None ? "" : "transfer-panel-selected")">
            <TitleContent>
                <TransferPanelHeader Icon="@panel.Icon" Title="@panel.Title"
                                     Count="@TransferSelectionProcessor.CountSelected(Graph, Selected, panel.Kind)"
                                     State="state" Disabled="@(rows.Count == 0)" Expanded="@_expanded[panel.Kind]"
                                     OnToggle="@(() => ToggleAllAsync(panel, state))" />
            </TitleContent>
            <ChildContent>
                <div class="transfer-rows">
                    <Virtualize Items="rows" ItemSize="RowHeight" Context="row">
                        @* Select and Info are sibling native buttons: a button cannot hold another interactive
                           control, and the native element brings focus and Enter/Space activation without the
                           page scrolling on Space. *@
                        <div @key="row.Key" class="@RowClass(row)">
                            <button type="button" class="transfer-row-select"
                                    aria-pressed="@(Selected.Contains(row.Key) ? "true" : "false")"
                                    @onclick="@(() => ToggleRowAsync(row))">
                                <span class="transfer-row-name">@row.Name</span>
                            </button>
                            <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Primary"
                                           title="@($"About {row.Name}")" aria-label="@($"About {row.Name}")"
                                           OnClick="@(() => ShowInfoAsync(row))" />
                        </div>
                    </Virtualize>
                </div>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>
