<MudTextField @bind-Value="Model.Name" @bind-Value:after="NotifyChangedAsync" Label="Name" Variant="Variant.Outlined"
              FullWidth="true" Required="true" RequiredError="Name is required" Immediate="true" Class="mb-4" />

<MudNumericField @bind-Value="Model.Value" @bind-Value:after="NotifyChangedAsync" Label="Value per item"
                 Variant="Variant.Outlined" FullWidth="true" Min="0.0" Class="mb-4" />

@* Min is the user-facing guard; Blueprint.Yield clamps as well, for anything reaching the model another way. *@
<MudNumericField T="long" @bind-Value="Model.Yield" @bind-Value:after="NotifyChangedAsync" Label="Yield per craft"
                 Variant="Variant.Outlined" FullWidth="true" Min="1" Class="mb-4" />

<ProductionTimeField @bind-Value="Model.ProductionTime" @bind-Value:after="NotifyChangedAsync"
                     Label="Production time per craft" />

<CategorySelect Model="Model" OnChanged="NotifyChangedAsync" />

<MudTextField @bind-Value="Model.Description" @bind-Value:after="NotifyChangedAsync" Label="Description"
              Variant="Variant.Outlined" FullWidth="true" Lines="3" Sizing="InputSizing.Auto" MaxLines="10" Class="mb-4" />

<MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Add"
           Class="mb-2" OnClick="OpenAddPartsAsync">Add requirements</MudButton>

@if (Parts.Count == 0)
{
    <div class="pane-empty-state">
        <MudText Typo="Typo.body1">No requirements yet</MudText>
        <MudText Typo="Typo.caption">Tap "Add requirements" above to add a component or another blueprint.</MudText>
    </div>
}
else
{
    <MudList T="IBaseQuantityRecord">
        @foreach (IBaseQuantityRecord part in Parts)
        {
            <MudListItem T="IBaseQuantityRecord">
                <div class="list-row">
                    <div class="list-row-info">
                        <MudText Class="list-row-name">@part.Name</MudText>
                        <MudText Typo="Typo.caption" Class="list-row-name">@part.Type.GetDescription()</MudText>
                    </div>
                    <div class="list-row-stepper">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Medium"
                                       OnClick="@(() => StepAsync(part, -1))" />
                        <MudNumericField T="long" Value="part.Quantity" ValueChanged="@(v => SetQuantityAsync(part, v))"
                                         Min="0" DebounceInterval="300" HideSpinButtons="true" Class="list-row-qty-field" />
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Medium"
                                       OnClick="@(() => StepAsync(part, 1))" />
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => RemoveAsync(part))" />
                </div>
            </MudListItem>
        }
    </MudList>
}
