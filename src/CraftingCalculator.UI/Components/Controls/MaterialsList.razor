<div class="materials-list">
    @if (Materials.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No components yet</MudText>
        </div>
    }
    else
    {
        <MudList T="ComponentQuantity" ReadOnly="true">
            @foreach (ComponentQuantity componentQuantity in Materials)
            {
                <MudListItem T="ComponentQuantity" @key="componentQuantity.Component.Id">
                    <RecordCard Name="@componentQuantity.Name" Record="@componentQuantity.Component"
                                Details="@DetailsFor(componentQuantity)" />
                </MudListItem>
            }
        </MudList>
    }
</div>
