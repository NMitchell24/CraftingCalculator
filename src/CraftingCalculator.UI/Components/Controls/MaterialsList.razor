@implements IDisposable

<div class="materials-list">
    @if (State.TotalComponents.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No components yet</MudText>
        </div>
    }
    else
    {
        <MudList T="ComponentQuantity">
            @foreach (ComponentQuantity componentQuantity in State.TotalComponents)
            {
                <MudListItem T="ComponentQuantity" OnClick="@(() => ShowInfoAsync(componentQuantity))">
                    <div class="materials-row">
                        <div class="card-row-header">
                            <MudText Class="list-row-name card-row-name">@componentQuantity.Name</MudText>
                            <CategoryChip Record="@componentQuantity.Component" Class="card-row-category" />
                        </div>
                        @* Labels and values are siblings in one grid rather than a column per stat, so
                           the two value cells share a baseline no matter how the labels wrap. *@
                        <div class="materials-row-stats">
                            <MudText Typo="Typo.caption" Class="materials-row-label">Quantity</MudText>
                            <MudText Typo="Typo.caption" Class="materials-row-label materials-row-end">Cost</MudText>
                            <MudText>x@(componentQuantity.Quantity)</MudText>
                            <MudText Class="materials-row-end">@string.Format(FormatConstants.CurrencyFormat, componentQuantity.TotalCost)</MudText>
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>
