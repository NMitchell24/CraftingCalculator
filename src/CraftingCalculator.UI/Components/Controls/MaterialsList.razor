@implements IDisposable

<div class="materials-list">
    @if (State.TotalIngredients.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No components yet</MudText>
        </div>
    }
    else
    {
        <MudList T="IngredientQuantity">
            @foreach (IngredientQuantity iq in State.TotalIngredients)
            {
                <MudListItem T="IngredientQuantity">
                    <div class="materials-row">
                        <MudText Class="list-row-name materials-row-name">@iq.Name</MudText>
                        @* Labels and values are siblings in one grid rather than a column per stat, so
                           the two value cells share a baseline no matter how the labels wrap. *@
                        <div class="materials-row-stats">
                            <MudText Typo="Typo.caption" Class="materials-row-label">Quantity</MudText>
                            <MudText Typo="Typo.caption" Class="materials-row-label materials-row-end">Cost</MudText>
                            <MudText Class="materials-row-value">x@(iq.Quantity)</MudText>
                            <MudText Class="materials-row-value materials-row-end">@string.Format(FormatConstants.CurrencyFormat, iq.TotalCost)</MudText>
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>
