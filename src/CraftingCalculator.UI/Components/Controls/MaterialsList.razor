<div class="materials-list">
    @if (Materials.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No components yet</MudText>
        </div>
    }
    else
    {
        <MudList T="IBaseQuantityRecord" ReadOnly="true">
            <VirtualList Items="Materials" ItemSize="RowHeight" OverscanCount="RecordCard.OverscanCount"
                        Context="quantity">
                @* Keyed on the type as well: already crafted blueprints are listed with the components, and the two
                   are numbered separately. *@
                <MudListItem T="IBaseQuantityRecord" @key="(quantity.Type, quantity.Record.Id)">
                    <RecordCard Name="@quantity.Name" Record="@quantity.Record" Details="@DetailsFor(quantity)"
                                OnInfo="@InfoFor(quantity)" />
                </MudListItem>
            </VirtualList>
        </MudList>
    }
</div>
