@implements IDisposable

<div class="materials-list">
    @if (State.TotalComponents.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No components yet</MudText>
        </div>
    }
    else
    {
        <MudList T="ComponentQuantity" Class="record-list" ReadOnly="true">
            @foreach (ComponentQuantity componentQuantity in State.TotalComponents)
            {
                <MudListItem T="ComponentQuantity">
                    <RecordCard Name="@componentQuantity.Name" Kind="@componentQuantity.Type.GetDescription()"
                                Record="@componentQuantity.Component" Details="@DetailsFor(componentQuantity)" />
                </MudListItem>
            }
        </MudList>
    }
</div>
