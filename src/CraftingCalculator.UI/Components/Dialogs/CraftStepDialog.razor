<MudDialog>
    <DialogContent>
        @* Same label/value grid as the Crafting Summary card - this is the same kind of read-only
           figure list, so it reuses those classes rather than cloning them under a step- prefix. *@
        <dl class="summary-grid">
            <dt>Quantity</dt>
            <dd>@Node.Quantity</dd>

            @if (!Node.IsComponent)
            {
                @* Crafts, yield and surplus only mean something for a blueprint. A component is
                   gathered, so it has no craft count and cannot be overproduced. Yield sits directly
                   above Surplus because it is what explains it: the surplus is only ever the remainder
                   of rounding the quantity up to a whole number of crafts of this size. *@
                <dt>Crafts</dt>
                <dd>@Node.Crafts</dd>

                <dt>Yield per Craft</dt>
                <dd>@Node.Yield</dd>

                <dt>Surplus</dt>
                <dd>@Node.Surplus</dd>
            }

            <dt>Production Time</dt>
            <dd>@DurationProcessor.Format(Node.ProductionTime)</dd>
        </dl>

        <MudText Typo="Typo.caption" Class="step-dialog-note">Details apply to this step only.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>
