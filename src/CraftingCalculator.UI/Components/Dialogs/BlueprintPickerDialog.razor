<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_search" Placeholder="Search blueprints" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mb-2" />

        <div class="picker-chip-row mb-2">
            <MudChipSet T="int" SelectedValue="@_selectedCategoryId" SelectedValueChanged="OnCategoryChanged"
                        SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary">
                @* Tertiary rather than the set's Primary: this chip is a filter control, not one of the
                   user's categories, and a user is free to name a category "All" too. *@
                <MudChip T="int" Text="@AllCategoriesLabel" Value="@AllCategoriesId" Color="Color.Tertiary" />
                @foreach (Domain.Models.CategoryModel category in _categories)
                {
                    <MudChip T="int" Text="@category.Name" Value="@category.Id" />
                }
            </MudChipSet>
        </div>

        @if (_filteredBlueprints.Count == 0)
        {
            <MudText Class="pa-4" Align="Align.Center">No blueprints match.</MudText>
        }
        else
        {
            <MudList T="BlueprintModel" @bind-SelectedValues="_selected" SelectionMode="SelectionMode.MultiSelection">
                @foreach (BlueprintModel blueprint in _filteredBlueprints)
                {
                    <MudListItem T="BlueprintModel" Value="@blueprint">
                        <MudText>@blueprint.Name</MudText>
                        <MudText Typo="Typo.caption">@blueprint.Category?.Name</MudText>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_selected.Count == 0)" OnClick="Confirm">
            Craft @_selected.Count blueprint@(_selected.Count == 1 ? "" : "s")
        </MudButton>
    </DialogActions>
</MudDialog>
