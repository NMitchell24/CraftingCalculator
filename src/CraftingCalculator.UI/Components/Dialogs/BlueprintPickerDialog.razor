@* The search bar is sticky inside the dialog content, which needs a hook of its own (app.css). *@
<MudDialog ContentClass="picker-dialog-content">
    <DialogContent>
        <RecordSearchBar Records="_blueprints" Placeholder="Search blueprints" FilterChanged="OnFilterChanged" />

        @if (FilteredBlueprints.Count == 0)
        {
            <MudText Class="pa-4" Align="Align.Center">No blueprints match.</MudText>
        }
        else
        {
            <MudList T="BlueprintModel" @bind-SelectedValues="_selected" SelectionMode="SelectionMode.MultiSelection">
                @foreach (BlueprintModel blueprint in FilteredBlueprints)
                {
                    <MudListItem T="BlueprintModel" Value="@blueprint">
                        <div class="list-row">
                            <div class="list-row-info">
                                <MudText Class="list-row-name">@blueprint.Name</MudText>
                            </div>
                            <CategoryChip Record="@blueprint" Class="card-row-category" />
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_selected.Count == 0)" OnClick="Confirm">
            Craft @_selected.Count blueprint@(_selected.Count == 1 ? "" : "s")
        </MudButton>
    </DialogActions>
</MudDialog>
