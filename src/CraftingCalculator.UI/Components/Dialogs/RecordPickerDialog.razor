@* No DialogActions: every tap applies to the Target as it happens, so there is nothing to confirm and Close is the
   only way out. It sits in the title, the one edge of a full-screen dialog the on-screen keyboard never covers. The
   search bar is sticky inside the dialog content (app.css). *@
<MudDialog ContentClass="picker-dialog-content">
    <TitleContent>
        <div class="picker-dialog-title">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Edge="Edge.Start" OnClick="Close" aria-label="Close" />
            <MudText Typo="Typo.h6" Class="picker-dialog-title-text">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <RecordSearchBar Records="Records" FilterChanged="OnFilterChanged" />

        @if (FilteredRecords.Count == 0)
        {
            <MudText Class="pa-4" Align="Align.Center">Nothing matches.</MudText>
        }
        else
        {
            <MudList T="IBaseDataRecord" Class="record-list">
                @foreach (IBaseDataRecord record in FilteredRecords)
                {
                    <MudListItem T="IBaseDataRecord" Ripple="false">
                        <div class="record-row">
                            <div class="record-row-name">
                                <MudText>@record.Name</MudText>
                                @if (_showType)
                                {
                                    <MudText Typo="Typo.caption" Class="record-row-caption">@record.Type.GetDescription()</MudText>
                                }
                            </div>
                            <div class="record-row-meta"><CategoryChip Record="@record" /></div>
                            @* index.html stops a tap on these buttons from taking focus off the search field, so
                               the keyboard stays up between searches. *@
                            <div class="record-row-end record-row-stepper">
                                @if (Target.Find(record) is { } entry)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Medium" aria-label="Less"
                                                   OnClick="@(() => Target.StepAsync(entry, -1))" />
                                    <MudNumericField T="long" Value="entry.Quantity" ValueChanged="@(v => Target.SetQuantityAsync(entry, v))"
                                                     Min="0" DebounceInterval="300" HideSpinButtons="true" Class="record-row-qty-field" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Medium" aria-label="More"
                                                   OnClick="@(() => Target.StepAsync(entry, 1))" />
                                }
                                else
                                {
                                    <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="@(() => Target.AddAsync(record))">Add</MudButton>
                                }
                            </div>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
</MudDialog>
