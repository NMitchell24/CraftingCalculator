@* No DialogActions: every tap applies to the Target as it happens, so there is nothing to confirm and Close is the
   only way out. It sits in the title, the one edge of a full-screen dialog the on-screen keyboard never covers. The
   search bar is sticky inside the dialog content (app.css). *@
<MudDialog ContentClass="picker-dialog-content">
    <TitleContent>
        <div class="closable-dialog-title">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Edge="Edge.Start" OnClick="Close" aria-label="Close" />
            <MudText Typo="Typo.h6" Class="closable-dialog-title-text">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <RecordSearchBar Records="Records" FilterList="FilterList" FilterChanged="OnFilterChanged" />

        @* An empty picker is a new user's dataset far more often than it is a bad search, and they have no way
           to tell the two apart. *@
        @if (Records.Count == 0)
        {
            <div class="pane-empty-state">
                <MudText Typo="Typo.body1">It looks like you don't have any data yet.</MudText>
                <MudText Typo="Typo.caption">New to the app? The Getting Started guide walks you through it.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@GettingStartedHref"
                           StartIcon="@Icons.Material.Filled.HelpOutline" Class="mt-2">Getting Started</MudButton>
            </div>
        }
        else if (FilteredRecords.Count == 0)
        {
            <MudText Class="pa-4" Align="Align.Center">@GetNoMatchPhrase</MudText>
        }
        else
        {
            <MudList T="IBaseDataRecord">
                @foreach (IBaseDataRecord record in FilteredRecords)
                {
                    <MudListItem T="IBaseDataRecord" Ripple="false">
                        @* js/keyboard.js stops a tap on the buttons in a card's stepper and actions zones from taking focus
                           off the search field, so the keyboard stays up between searches. *@
                        @if (Target.Find(record) is { } entry)
                        {
                            <RecordCard Name="@(record.Name ?? "")" Record="@record">
                                <Stepper>
                                    <QuantityStepper Quantity="@entry.Quantity" OnStep="@(step => Target.StepAsync(entry, step))"
                                                     OnQuantityChanged="@(quantity => Target.SetQuantityAsync(entry, quantity))" />
                                </Stepper>
                                <Actions>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                   title="@RemoveLabel(record)" aria-label="@RemoveLabel(record)"
                                                   OnClick="@(() => Target.RemoveAsync(entry))" />
                                </Actions>
                            </RecordCard>
                        }
                        else
                        {
                            <RecordCard Name="@(record.Name ?? "")" Record="@record">
                                <Stepper>
                                    <MudButton Class="quantity-stepper-add" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="@(() => Target.AddAsync(record))">Add</MudButton>
                                </Stepper>
                            </RecordCard>
                        }
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
</MudDialog>
