@page "/favorites"

<PageTitle>Favorites</PageTitle>

<div class="favorites-page">
    @if (_favorites.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No saved selections</MudText>
            <MudText Typo="Typo.caption">Build a selection on the Craft screen, then save it from there.</MudText>
        </div>
    }
    else
    {
        @* Outside Delete mode the list is ReadOnly, so a card is a plain list item: no clickable styling, ripple,
           option role or tab stop. ReadOnly still invokes MudListItem.OnClick on a tap, which is why
           ToggleSelection keeps its own mode check. *@
        <MudList T="BlueprintFavorite" ReadOnly="@(_mode != ListMode.Delete)">
            @foreach (BlueprintFavorite favorite in _favorites)
            {
                <MudListItem T="BlueprintFavorite" Class="@RowClass(favorite)" OnClick="@(() => ToggleSelection(favorite))">
                    <RecordCard Name="@(favorite.Name ?? "")" Details="@DetailsFor(favorite)"
                                OnInfo="@(() => ShowInfoAsync(favorite))">
                        <Actions>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                           title="@($"Rename {favorite.Name}")" aria-label="@($"Rename {favorite.Name}")"
                                           OnClick="@(() => RenameAsync(favorite))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                           title="@($"Delete {favorite.Name}")" aria-label="@($"Delete {favorite.Name}")"
                                           OnClick="@(() => DeleteAsync(favorite))" />
                        </Actions>
                    </RecordCard>
                </MudListItem>
            }
        </MudList>
    }
</div>
