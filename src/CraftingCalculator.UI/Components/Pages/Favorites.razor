@page "/favorites"
@implements IDisposable

<PageTitle>Favorites</PageTitle>

<div class="favorites-page">
    @if (_favorites.Count == 0)
    {
        <div class="pane-empty-state">
            <MudText Typo="Typo.body1">No saved selections</MudText>
            <MudText Typo="Typo.caption">Build a selection on the Craft screen, then save it from there.</MudText>
        </div>
    }
    else
    {
        <MudList T="BlueprintFavorite">
            @foreach (BlueprintFavorite favorite in _favorites)
            {
                <MudListItem T="BlueprintFavorite" OnClick="@(() => RenameAsync(favorite))">
                    <div class="list-row">
                        <div class="list-row-info">
                            <MudText Class="list-row-name">@favorite.Name</MudText>
                            <MudText Typo="Typo.caption" Class="list-row-name">
                                @favorite.BlueprintCount blueprint@(favorite.BlueprintCount == 1 ? "" : "s")
                            </MudText>
                        </div>
                        @* The row itself opens the rename dialog, so the row actions have to stop the
                           event before it bubbles. @onclick:stopPropagation can only be applied to an
                           element, never a component tag, hence the wrapper div. *@
                        <div class="list-row-actions" @onclick="() => { }" @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                           title="@($"Rename {favorite.Name}")" aria-label="@($"Rename {favorite.Name}")"
                                           OnClick="@(() => RenameAsync(favorite))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary"
                                           title="@($"Delete {favorite.Name}")" aria-label="@($"Delete {favorite.Name}")"
                                           OnClick="@(() => DeleteAsync(favorite))" />
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>
