@page "/"

<div class="craft-page">
    @* Two columns only at >=960x600 (app.css); everything stacks below that. The batch and the summary
       ride together because both describe the whole batch, while the content card is the one thing that
       switches. *@
    <div class="craft-columns">
        <div class="craft-column">
            <MudPaper Class="app-card" Elevation="0">
                @* The loader shares the heading's row rather than taking one of its own: the batch list
                   starts directly below it, and a full row of chrome pushes the batch off a phone screen. *@
                <div class="craft-batch-title-row">
                    <MudText Typo="Typo.subtitle1" Class="app-card-title display-title">Selected Blueprints</MudText>
                    @* Bound on the favorite's id rather than the BlueprintFavorite itself, for the reason
                       the category select in BlueprintEditor.razor is: the model has no value equality, so
                       MudSelect's reference comparison would never preselect the loaded favorite.
                       OuterClass rather than Class: Class lands on the inner MudInputControl, and the flex
                       width has to sit on the outer div, which is this row's flex item. *@
                    <MudSelect T="int?" @key="FavoriteSelectKey" Value="SelectedFavoriteId" ValueChanged="OnFavoriteSelectedAsync"
                               Label="@FavoriteSelectLabel" Disabled="@(_favorites.Count == 0)"
                               Variant="Variant.Outlined" Margin="Margin.Dense" OuterClass="craft-favorite-select">
                        @foreach (BlueprintFavorite favorite in _favorites)
                        {
                            <MudSelectItem T="int?" Value="@favorite.Id">@favorite.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <BatchList State="State" OnAddBlueprints="OpenPickerAsync" />
            </MudPaper>

            <SummaryCard State="State" />
        </div>

        <div class="craft-column">
            <MudPaper Class="app-card" Elevation="0">
                @* Tabs and actions are separate rows on purpose. Sharing one row sized the tab bar by
                   whatever the actions left over, so it changed width on every switch - Materials has one
                   action and Steps has two. Every tab has an action, so no row ever empties. *@
                <div class="pane-tabs">
                    <MudToggleGroup T="CraftView" Value="_view" ValueChanged="OnViewChanged" Class="segmented"
                                    SelectedClass="segmented-selected" Outlined="false" Delimiters="false" Size="Size.Small">
                        @* "Steps" rather than "Crafting Steps": the group is an equal-column grid, so a third
                           segment leaves each one about a third of a phone's width. The Crafting Summary card
                           still spells it out. Below a width too narrow for all three labels on one line each,
                           the .pane-tabs container query in app.css (keyed on the zoom-aware ch unit) stacks
                           the group into three full-width pills instead of letting a label wrap mid-word. *@
                        <MudToggleItem Value="CraftView.Materials">Components</MudToggleItem>
                        <MudToggleItem Value="CraftView.Steps">Steps</MudToggleItem>
                        @if (UseYield)
                        {
                            <MudToggleItem Value="CraftView.Surplus">Surplus</MudToggleItem>
                        }
                    </MudToggleGroup>
                </div>

                @* Labeled rather than icon-only: these sit on their own row, not the tab row, so there is space to
                   say what they do. *@
                <div class="pane-actions">
                    @if (_view == CraftView.Materials)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy"
                                   Disabled="@(State.TotalComponents.Count == 0)" OnClick="CopyMaterialsAsync">Copy</MudButton>
                    }
                    else if (_view == CraftView.Surplus)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy"
                                   Disabled="@(State.SurplusStock.Count == 0)" OnClick="CopySurplusAsync">Copy</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldMore"
                                   OnClick="@ExpandAllClicked">Expand all</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldLess"
                                   OnClick="@CollapseAllClicked">Collapse all</MudButton>
                    }
                </div>

                @* Only the active pane is rendered: a hidden one would still re-render on every change to the batch,
                   and on a big batch the other two are thousands of rows. The tree's expansion lives in CraftState,
                   so switching away and back loses nothing. *@
                @if (_view == CraftView.Materials)
                {
                    <MaterialsList Materials="State.TotalComponents" />
                }
                else if (_view == CraftView.Steps)
                {
                    <StepsTree Roots="State.TreeRoots" />
                }
                else if (UseYield)
                {
                    <SurplusList Surplus="State.SurplusStock" />
                }
            </MudPaper>
        </div>
    </div>
</div>
