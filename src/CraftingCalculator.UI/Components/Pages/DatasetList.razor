@page "/dataset/{Type}"
@implements IDisposable

<PageTitle>Dataset</PageTitle>

<div class="dataset-page">
    @* Keyed on the type: the router reuses this page instance when only {Type} changes, so without it
       the bar would keep the previous type's search text and selection. *@
    <RecordSearchBar @key="_type" Records="_records" FilterChanged="OnFilterChanged" />

    @if (FilteredRecords.Count == 0)
    {
        <div class="pane-empty-state">
            @if (_records.Count == 0)
            {
                <MudText Typo="Typo.body1">Nothing here yet</MudText>
                <MudText Typo="Typo.caption">Use the + action to create one.</MudText>
            }
            else
            {
                <MudText Typo="Typo.body1">No matches</MudText>
                <MudText Typo="Typo.caption">Nothing here matches the current filter.</MudText>
            }
        </div>
    }
    else
    {
        <MudList T="IBaseDataRecord">
            @foreach (IBaseDataRecord record in FilteredRecords)
            {
                <MudListItem T="IBaseDataRecord" Class="@RowClass(record)" OnClick="@(() => OnRowClick(record))">
                    <div class="list-row">
                        <div class="list-row-info">
                            <MudText Class="list-row-name">@record.Name</MudText>
                            <MudText Typo="Typo.caption" Class="list-row-name">@CaptionFor(record)</MudText>
                        </div>
                        <CategoryChip Record="@record" Class="card-row-category" />
                        @* Same shape as Favorites.razor: the row itself has a tap action, so the row
                           buttons have to stop the event before it bubbles, and
                           @onclick:stopPropagation only applies to an element - hence the wrapper. *@
                        <div class="list-row-actions" @onclick="() => { }" @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                           title="@($"Edit {record.Name}")" aria-label="@($"Edit {record.Name}")"
                                           OnClick="@(() => Edit(record))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Primary"
                                           title="@($"Delete {record.Name}")" aria-label="@($"Delete {record.Name}")"
                                           OnClick="@(() => DeleteAsync(record))" />
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>
