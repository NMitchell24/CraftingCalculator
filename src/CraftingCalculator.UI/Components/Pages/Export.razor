@page "/dataset/import-export/export"
@using CraftingCalculator.Domain.Models.Transfer

<PageTitle>Export Data</PageTitle>

<div class="dataset-page transfer-page">
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="transfer-alert">@_loadError</MudAlert>
    }
    else if (_snapshot is null || _graph is null)
    {
        <div class="transfer-status">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.body1">Loading your dataset…</MudText>
        </div>
    }
    else
    {
        @if (CycleMessage is { } cycleMessage)
        {
            <MudAlert Severity="Severity.Warning" Class="transfer-alert">@cycleMessage</MudAlert>
        }

        <MudPaper Class="app-card" Elevation="0">
            <MudText Typo="Typo.h6" Class="app-card-title display-title">Choose what you want to export</MudText>

            <MudText Typo="Typo.body1">
                Tap on any item to exclude it from the export. Tap the checkmark at the top of each group to
                select or deselect an entire group. Exports you have created will display at the bottom of
                the screen ordered from the most recent to the oldest.
            </MudText>
        </MudPaper>

        <TransferSelectionPanels Snapshot="_snapshot" Graph="_graph" Selected="_selected"
                                 SelectionChanged="ConfigureShell" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="transfer-action"
                   StartIcon="@Icons.Material.Filled.Output" Disabled="@(!CanExport)" OnClick="@ExportAsync">
            Export data
        </MudButton>
    }

    @* Inline rather than the busy overlay: the export runs in the background, and the user is free to leave
       and come back to it. *@
    @if (ExportState.IsRunning)
    {
        <div class="transfer-status">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.body1">Building your export…</MudText>
        </div>
    }
    else
    {
        @if (ExportState.LastError is { } error)
        {
            <MudAlert Severity="Severity.Error" Class="transfer-alert">@error</MudAlert>
        }

        @if (ExportState.Exports.Count > 0)
        {
            <MudPaper Class="app-card" Elevation="0">
                <MudText Typo="Typo.subtitle1" Class="transfer-export-heading display-title">Export history</MudText>

                @foreach (ExportFileInfo export in ExportState.Exports)
                {
                    <div class="app-card transfer-export" @key="export.FullPath">
                        <div class="transfer-export-detail">
                            <MudText Typo="Typo.subtitle1" Class="transfer-export-name">@export.DatasetName</MudText>
                            <MudText Typo="Typo.body2">@export.CreatedAt.ToLocalTime().ToString("f")</MudText>
                            <MudText Typo="Typo.caption" Class="transfer-export-location">@export.FileName</MudText>
                            <MudText Typo="Typo.caption" Class="transfer-export-location">@LocationOf(export)</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Share" Color="Color.Primary"
                                       title="@ShareLabel(export)" aria-label="@ShareLabel(export)"
                                       OnClick="@(() => ShareAsync(export))" />
                    </div>
                }
            </MudPaper>
        }
    }
</div>
