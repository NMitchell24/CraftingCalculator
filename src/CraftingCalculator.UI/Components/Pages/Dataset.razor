@page "/dataset"
@implements IDisposable

<PageTitle>Dataset</PageTitle>

<div class="dataset-page">
    @foreach (DatasetSection section in Sections)
    {
        <MudPaper Class="app-card dataset-summary-card" Elevation="0" @key="section.Type" onclick="@(() => OpenList(section.Type))">
            <div class="dataset-summary-row">
                <div class="dataset-summary-info">
                    <MudText Typo="Typo.subtitle1" Class="app-card-title display-title">@section.Title</MudText>
                    <MudText Typo="Typo.body2" Class="dataset-summary-count">@section.Caption</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                               OnClick="@(() => OpenList(section.Type))"
                               title="@($"Edit {section.Title}")" aria-label="@($"Edit {section.Title}")" />
            </div>
        </MudPaper>
    }
</div>

<MudOverlay Visible="_busy" DarkBackground="true" ZIndex="9999">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
</MudOverlay>
