@page "/settings"

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    <MudPaper Class="app-card" Elevation="0">
        <MudText Typo="Typo.subtitle1" Class="settings-section-title display-title">Appearance</MudText>
        <MudDivider Class="my-4" />

        <MudRadioGroup T="ThemeMode" Value="@ThemeState.Mode" ValueChanged="ThemeState.SetMode">
            <MudRadio T="ThemeMode" Value="ThemeMode.System">Follow system</MudRadio>
            <MudRadio T="ThemeMode" Value="ThemeMode.Light">Light</MudRadio>
            <MudRadio T="ThemeMode" Value="ThemeMode.Dark">Dark</MudRadio>
        </MudRadioGroup>
    </MudPaper>

    <MudPaper Class="app-card" Elevation="0">
        <MudText Typo="Typo.subtitle1" Class="settings-section-title display-title">Exports</MudText>
        <MudDivider Class="my-4" />

        <MudNumericField T="int" Value="ExportSettings.KeptExports" ValueChanged="ExportSettings.SetKeptExports"
                         Label="Max history" Variant="Variant.Outlined"
                         Min="@ExportConstants.MinimumKeptExports" Max="@ExportConstants.MaximumKeptExports"
                         HideSpinButtons="true" Class="settings-number-field" />
    </MudPaper>

    <MudPaper Class="app-card" Elevation="0">
        <MudText Typo="Typo.subtitle1" Class="settings-section-title display-title">Diagnostics</MudText>
        <MudDivider Class="my-4" />

        <MudText Typo="Typo.body2">
            The app keeps a small log on this device of what it did and anything that went wrong. It never
            records your dataset, and it stays here unless you send it somewhere.
        </MudText>

        <div class="setting-row mt-2">
            <div class="setting-text">
                <MudText Typo="Typo.body1">Enable Trace Logging</MudText>
                <MudText Typo="Typo.caption" Class="setting-caption">
                    Also logs screen changes, dialog closes, and important actions. Leave it off unless you're chasing
                    down a problem.
                </MudText>
            </div>
            <MudSwitch T="bool" @key="_traceSwitchGeneration" Value="DiagnosticSettings.TraceLogging"
                       ValueChanged="SetTraceLoggingAsync" Color="Color.Primary" AriaLabel="Enable Trace Logging" />
        </div>

        <MudButton Color="Color.Primary" OnClick="ShowLogsAsync" Class="mt-2">View logs</MudButton>
    </MudPaper>

    <MudPaper Class="app-card" Elevation="0">
        <MudText Typo="Typo.subtitle1" Class="settings-section-title display-title">About</MudText>
        <MudDivider Class="my-4" />

        <MudText Typo="Typo.body1">Crafting Calculator</MudText>
        <MudText Typo="Typo.body2">Version @Version</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">Copyright &copy; @DateTime.Now.Year Sterling Turd Productions, LLC</MudText>

        <MudText Typo="Typo.body2" Class="mb-2">Privacy and free software commitment</MudText>
        <MudText Typo="Typo.caption" Class="settings-license">
            This app is free, and it will stay free forever. Every version published by Sterling Turd
            Productions, LLC will remain free of charge, and will never contain advertisements, telemetry,
            tracking or data collection of any kind. Your data stays on your device unless you choose to send it somewhere.
        </MudText>

        <MudText Typo="Typo.body2" Class="mb-2">Licensed under a Custom Source-Available and Personal Use License</MudText>
        <MudText Typo="Typo.caption" Class="settings-license">
            You may download, view, fork, modify and compile the source code of this app strictly for
            personal, non-commercial use. You may publish builds of the app or a modified version of it on GitHub,
            but you may not sell builds that you create, or publish them to any app store, marketplace or
            other distribution platform other than GitHub. Publishing rights for distribution on stores and
            marketplaces are reserved to Sterling Turd Productions, LLC. The full text of the license is available on
            this application's public Source Code repository on GitHub. </MudText>
        <MudText Typo="Typo.caption" Class="settings-license">
            This program is provided "as is", WITHOUT WARRANTY OF ANY KIND, express or implied, including
            the implied warranties of MERCHANTABILITY and FITNESS FOR A PARTICULAR PURPOSE. The full license
            is published with the source code.
        </MudText>

        <MudText Typo="Typo.body2" Class="mb-2">Fonts</MudText>
        <MudText Typo="Typo.caption" Class="settings-license">
            Inter, copyright &copy; The Inter Project Authors. Jersey 20, copyright &copy; The Soft Type
            Project Authors. Both are licensed under the SIL Open Font License, Version 1.1, and are
            bundled with this app so it renders identically offline.
        </MudText>
    </MudPaper>
</div>
