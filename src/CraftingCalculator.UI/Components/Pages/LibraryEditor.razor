@page "/library/{Type}/{Id:int}"
@implements IDisposable

<PageTitle>Dataset</PageTitle>

@if (_record is not null)
{
    <div class="library-editor">
        @* The one place this screen branches on the record type. Every data operation goes through
           ILibraryService instead, which is why there is no matching switch for load/save/delete. *@
        @switch (_record)
        {
            case Ingredient ingredient:
                <IngredientEditor @key="_record" Model="ingredient" OnChanged="MarkDirty" />
                break;
            case RecipeFilter filter:
                <CategoryEditor @key="_record" Model="filter" OnChanged="MarkDirty" />
                break;
            case Recipe recipe:
                <RecipeEditor @key="_record" Model="recipe" OnChanged="MarkDirty" />
                break;
        }
    </div>

    <MudPaper Class="editor-action-bar" Elevation="8" Square="true">
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@string.IsNullOrWhiteSpace(_record.Name)" OnClick="SaveAsync">Save</MudButton>
    </MudPaper>
}
